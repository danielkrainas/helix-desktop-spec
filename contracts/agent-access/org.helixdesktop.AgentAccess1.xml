<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.helixdesktop.AgentAccess1 — Helix extension (CC0). The Settings
  page's view of Agent Access: list agents and take access away, list and
  cancel agents' reminders. Served by
  the shell on its main connection as org.gnome.Shell, object
  /org/helixdesktop/Agent1. Only the Settings app may call it (README.md,
  "Who may manage grants"). No method grants or widens access.
-->
<node>
  <interface name="org.helixdesktop.AgentAccess1">
    <method name="ListAgents">
      <arg type="aa{sv}" name="agents" direction="out"/>
    </method>
    <!-- Ends the agent's session grant (and this session's denial). -->
    <method name="Revoke">
      <arg type="s" name="agent" direction="in"/>
    </method>
    <!-- Revoke, and forget a remembered (Always allow) grant. -->
    <method name="Forget">
      <arg type="s" name="agent" direction="in"/>
    </method>
    <!-- Revoke every agent's session grant. -->
    <method name="StopAll"/>
    <!-- Empties the activity log (helixdesktop/desktop#144). -->
    <method name="ClearLog"/>
    <!-- Every agent's reminders not yet shown (helixdesktop/desktop#148):
         Reminder records with agent, executable and name, by time. -->
    <method name="ListReminders">
      <arg type="aa{sv}" name="reminders" direction="out"/>
    </method>
    <!-- Cancels any agent's reminder; an unknown id is not an error. -->
    <method name="CancelReminder">
      <arg type="s" name="id" direction="in"/>
    </method>
    <signal name="AgentsChanged"/>
    <!-- A reminder was added, shown or cancelled. -->
    <signal name="RemindersChanged"/>
  </interface>
</node>
