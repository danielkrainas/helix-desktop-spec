<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.helix.Extension1.Host
  Helix's own interface (extensions API 1.0); behavior in README.md.
-->
<node>
  <interface name="org.helix.Extension1.Host">
    <method name="Hello">
      <arg type="s" direction="in" name="api_version"/>
      <arg type="s" direction="out" name="api_version"/>
      <arg type="as" direction="out" name="permissions"/>
      <arg type="a{sv}" direction="out" name="info"/>
    </method>
    <method name="GetSetting">
      <arg type="s" direction="in" name="key"/>
      <arg type="v" direction="out" name="value"/>
    </method>
    <method name="SetSetting">
      <arg type="s" direction="in" name="key"/>
      <arg type="v" direction="in" name="value"/>
    </method>
    <method name="Log">
      <arg type="u" direction="in" name="level"/>
      <arg type="s" direction="in" name="message"/>
    </method>
    <method name="ShowNotice">
      <arg type="s" direction="in" name="title"/>
      <arg type="s" direction="in" name="body"/>
      <arg type="s" direction="in" name="icon"/>
    </method>
    <method name="InhibitIdle">
      <arg type="s" direction="in" name="reason"/>
      <arg type="u" direction="out" name="handle"/>
    </method>
    <method name="Uninhibit">
      <arg type="u" direction="in" name="handle"/>
    </method>
    <method name="Launch">
      <arg type="s" direction="in" name="desktop_id"/>
      <arg type="as" direction="in" name="uris"/>
    </method>
    <signal name="SettingChanged">
      <arg type="s" name="key"/>
      <arg type="v" name="value"/>
    </signal>
  </interface>
</node>
