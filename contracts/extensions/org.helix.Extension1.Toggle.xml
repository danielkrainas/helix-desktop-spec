<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.helix.Extension1.Toggle
  Helix's own interface (extensions API 1.0); behavior in README.md.
-->
<node>
  <interface name="org.helix.Extension1.Toggle">
    <property name="Title" type="s" access="read"/>
    <property name="Subtitle" type="s" access="read"/>
    <property name="Icon" type="s" access="read"/>
    <property name="Active" type="b" access="read"/>
    <property name="Sensitive" type="b" access="read"/>
    <property name="Details" type="o" access="read"/>
    <method name="SetActive">
      <arg type="b" direction="in" name="active"/>
    </method>
  </interface>
</node>
