<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.helix.PortalDialog — Helix-private (CC0). Dialogs and app state the
  portal backends ask the shell for. Served by the shell (org.gnome.Shell)
  at /org/helix/PortalDialog. Notes in org.freedesktop.impl.portal.md
  ("Access", "Account", "AppChooser", "Background", "Wallpaper", "Print", "FileChooser").
-->
<node>
  <interface name="org.helix.PortalDialog">
    <!-- A question; check_label empty: no check box. -->
    <method name="Ask">
      <arg name="title" type="s" direction="in"/>
      <arg name="message" type="s" direction="in"/>
      <arg name="description" type="s" direction="in"/>
      <arg name="grant_label" type="s" direction="in"/>
      <arg name="deny_label" type="s" direction="in"/>
      <arg name="check_label" type="s" direction="in"/>
      <arg name="check" type="b" direction="in"/>
      <arg name="granted" type="b" direction="out"/>
      <arg name="checked" type="b" direction="out"/>
    </method>
    <!-- Pick one of items (desktop ids with names); "" when canceled. -->
    <method name="ChooseApp">
      <arg name="title" type="s" direction="in"/>
      <arg name="message" type="s" direction="in"/>
      <arg name="items" type="a(ss)" direction="in"/>
      <arg name="selected" type="s" direction="in"/>
      <arg name="choice" type="s" direction="out"/>
    </method>
    <!-- New items for the open ChooseApp dialog (its selection stays on
         the same name when still listed; no items cancel it). Returns
         false when no ChooseApp dialog is open. -->
    <method name="UpdateApps">
      <arg name="items" type="a(ss)" direction="in"/>
      <arg name="updated" type="b" direction="out"/>
    </method>
    <!--
      A general dialog, described by options (all optional):
        title, message, description (s); accept, cancel (s): button labels;
        check-label (s), check (b): a check box;
        picture (s): an image file to show (scaled down);
        rows (as), selected (i): rows to pick one of;
        entry-label (s), entry (s): a text field and its first text;
        warning (s): a line in a warning color;
        multiple (b): rows can be picked together (a click or Space toggles
          one; the current row is outlined), except those in
        unpickable (ai);
        activate-rows (b): clicking the current row again accepts (not for
          pickable rows);
        places (as), place-current (i): a column of places left of the
          rows (at most 14), the current one marked; clicking a place
          accepts.
        previews (as): a file per row ("" for none); with any, an area
          below the rows shows the selected row's file as a picture
          (decoded by the shell; "No preview" when it cannot be).
      response: 0 accepted, 1 canceled. results: check (b), selected (i),
      entry (s, with a text field), picked (ai, with multiple), place (i,
      when a place was clicked).
    -->
    <method name="Dialog">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="response" type="u" direction="out"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <!-- Apps with windows: app id to 1 (running) or 2 (focused). -->
    <method name="RunningApps">
      <arg name="apps" type="a{su}" direction="out"/>
    </method>
    <signal name="RunningAppsChanged"/>
  </interface>
</node>
