<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.gnome.Mutter.ScreenCast (+ .Session, .Stream)
  Source: https://gitlab.gnome.org/GNOME/mutter/-/blob/51.0/data/dbus-interfaces/org.gnome.Mutter.ScreenCast.xml
  Pinned against GNOME 51 surface. Interface shape only; behavior notes in
  org.gnome.Mutter.ScreenCast.md.
-->
<node>
  <interface name="org.gnome.Mutter.ScreenCast">
    <method name="CreateSession">
      <arg name="properties" type="a{sv}" direction="in" />
      <arg name="session_path" type="o" direction="out" />
    </method>
    <property name="Version" type="i" access="read" />
  </interface>
  <interface name="org.gnome.Mutter.ScreenCast.Session">
    <method name="Start" />
    <method name="Stop" />
    <signal name="Closed" />
    <method name="RecordMonitor">
      <arg name="connector" type="s" direction="in" />
      <arg name="properties" type="a{sv}" direction="in" />
      <arg name="stream_path" type="o" direction="out" />
    </method>
    <method name="RecordWindow">
      <arg name="properties" type="a{sv}" direction="in" />
      <arg name="stream_path" type="o" direction="out" />
    </method>
    <method name="RecordArea">
      <arg name="x" type="i" direction="in" />
      <arg name="y" type="i" direction="in" />
      <arg name="width" type="i" direction="in" />
      <arg name="height" type="i" direction="in" />
      <arg name="properties" type="a{sv}" direction="in" />
      <arg name="stream_path" type="o" direction="out" />
    </method>
    <method name="RecordVirtual">
      <arg name="properties" type="a{sv}" direction="in" />
      <arg name="stream_path" type="o" direction="out" />
    </method>
  </interface>
  <interface name="org.gnome.Mutter.ScreenCast.Stream">
    <method name="Start"/>
    <method name="Stop"/>
    <signal name="PipeWireStreamAdded">
      <arg name="node_id" type="u" direction="out" />
    </signal>
    <property name="Parameters" type="a{sv}" access="read" />
  </interface>
</node>
