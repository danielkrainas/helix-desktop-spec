<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Portal backend interface (xdg-desktop-portal); notes in org.freedesktop.impl.portal.md -->
<node>
  <interface name="org.freedesktop.impl.portal.Background">
    <method name="GetAppState">
      <arg name="apps" type="a{sv}" direction="out"/>
    </method>
    <method name="NotifyBackground">
      <arg name="handle" type="o" direction="in"/>
      <arg name="app_id" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="response" type="u" direction="out"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="EnableAutostart">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="enable" type="b" direction="in"/>
      <arg name="commandline" type="as" direction="in"/>
      <arg name="flags" type="u" direction="in"/>
      <arg name="result" type="b" direction="out"/>
    </method>
    <signal name="RunningApplicationsChanged"/>
  </interface>
</node>
